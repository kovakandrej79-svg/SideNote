{
  "name": "context-lexicon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "选中英文词句，结合全文语境给出释义、语感与文化背景",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "build:only": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@mozilla/readability": "^0.5.0",
    "@preact/signals": "^2.0.1",
    "@types/katex": "^0.16.8",
    "dompurify": "^3.2.4",
    "katex": "^0.18.4",
    "marked": "^15.0.7",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@preact/preset-vite": "^2.10.1",
    "@types/chrome": "^0.0.313",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
